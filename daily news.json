        "jsCode": "return items.map(item => {\n  let html = item.json.content;\n\n  // Remove HTML tags\n  let text = html.replace(/<[^>]*>/g, '');\n\n  // Decode common HTML entities\n  text = text\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .trim();\n\n  item.json.cleanedContent = text;\n\n  return item;\n});"
      },
