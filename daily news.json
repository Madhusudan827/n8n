    {
      "parameters": {
        "jsCode": "const news = $input.first().json.data;\n\nlet message = \"📰 *Today's News*\\n\\n\";\n\nnews.forEach((item, index) => {\n  const headline = (\"headline\" || \"\").replace(/\\s*-\\s*.*$/, \"\");\n  const summary = (item.summary || \"\").replace(/\\s*-\\s*.*$/, \"\");\n  const date = item[\"date and time\"] || \"\";\n\n  message += `*${index + 1}. ${headline}*\\n`;\n  message += `${summary}\\n`;\n  message += `🕒 ${date}\\n\\n`;\n});\n\nreturn [{\n  json: {\n    message\n  }\n}];"
      },
